# Copy to .env (git-ignored) and fill in. Never commit real values.

# Claude via the Anthropic API. Without a key the app still runs: the brief shows
# market data, figures and quoted filing excerpts, and chat says it is unavailable.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Reasoning effort per call: low | medium | high | xhigh | max
BRIEF_EFFORT=medium
CHAT_EFFORT=low

# SEC asks automated clients to identify themselves with a contact.
SEC_USER_AGENT="TickerAgent prototype research@example.com"

# Public-URL protection (per container). Visitors are identified by the first
# X-Forwarded-For entry, else the connection address.
RATE_LIMIT_PER_MINUTE=10
SEARCH_LIMIT_PER_MINUTE=90
DAILY_AI_CALLS=300

LOG_LEVEL=INFO
